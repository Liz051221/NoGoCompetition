  "board_entry": "启动棋盘.command",
  "version": "2026.10.24-simplified-board-ui",
  "records": {
    "directory": "棋谱",
    "format": "UTF-8 NG: ([NG][black team][white team][result][date time venue][event];B[D5];W[E5])",
    "filename": "先手名称vs后手名称，胜者名称胜.txt",
    "duplicate_names": "append （2）, （3）, ... without overwriting",
    "coordinates": "A-I columns and 1-9 rows, A1 at top left; original SAU protocol remains internal",
    "metadata_fields": [
      "NG",
      "black team",
      "white team",
      "先手胜/后手胜/平局",
      "YYYY.MM.DD HH:MM venue",
      "event name"
    ],
    "annotations": "Optional MARK[-2..2], omitted if no evaluation exists"
  },
  "board_clock": {
    "total_seconds": 900,
    "thinking_seconds": 720,
    "reserve_seconds": 180,
    "timeout": "loss",
    "pause": "clock stops after current AI move finishes"
  },
  "default_ai_move_cap_seconds": 60,
  "human_moves": "select an intersection, then explicitly confirm; selection time is counted",
  "board_ui": {
    "timers": "names and total remaining time only",
    "search_controls": "removed; default long search retained",
    "top_right_search_status": "removed"
  }
}
